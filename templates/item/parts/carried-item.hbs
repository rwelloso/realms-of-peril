<div class="form-group">
  <label>{{localize "ROP.CARRIEDITEM.FIELDS.price.label"}}</label>
  <input type="number" name="system.price" value="{{system.price}}" min="0" />
</div>
<div class="form-group">
  <label>{{localize "ROP.CARRIEDITEM.FIELDS.heavyCost.label"}}</label>
  <select name="system.heavyCost">
    <option value="0" {{#if (eq system.heavyCost 0)}}selected{{/if}}>0</option>
    <option value="1" {{#if (eq system.heavyCost 1)}}selected{{/if}}>1</option>
    <option value="2" {{#if (eq system.heavyCost 2)}}selected{{/if}}>2</option>
  </select>
</div>
<div class="form-group">
  <label>{{localize "ROP.CARRIEDITEM.FIELDS.container.label"}}</label>
  <input type="text" name="system.container" value="{{system.container}}" />
</div>
