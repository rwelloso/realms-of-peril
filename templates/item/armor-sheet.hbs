<form class="rop-item-sheet rop-armor-sheet" autocomplete="off">

  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" alt="{{item.name}}" />
    <input type="text" name="name" value="{{item.name}}" class="item-name" />
  </header>

  {{> "systems/rop/templates/item/parts/carried-item.hbs"}}

  <div class="form-group">
    <label>{{localize "ROP.ARMOR.FIELDS.armorRating.label"}}</label>
    <input type="number" name="system.armorRating" value="{{system.armorRating}}" min="0" />
  </div>

  <div class="form-group">
    <label>{{localize "ROP.ARMOR.FIELDS.equipSlot.label"}}</label>
    <select name="system.equipSlot">
      {{selectOptions equipSlots selected=system.equipSlot labelAttr="label" localize=true}}
    </select>
  </div>

  <div class="form-group">
    <label>{{localize "ROP.ARMOR.FIELDS.properties.label"}}</label>
    <multi-checkbox name="system.properties">
      {{#each itemProperties as |entry|}}
      <option value="{{entry.key}}" {{#if entry.checked}}selected{{/if}}>{{localize entry.label}}</option>
      {{/each}}
    </multi-checkbox>
  </div>

  <section class="description">
    <label>{{localize "ROP.ARMOR.FIELDS.description.label"}}</label>
    <prose-mirror name="system.description" value="{{system.description}}" document-uuid="{{item.uuid}}">{{{enrichedDescription}}}</prose-mirror>
  </section>

</form>
